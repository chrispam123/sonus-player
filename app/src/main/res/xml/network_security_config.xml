<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Permite tráfico HTTP (cleartext) a todos los dominios. -->
    <!-- Necesario para streaming de audio desde CDNs de ccMixter y otros. -->
    <!-- El riesgo es mínimo: solo transmite audio, no datos sensibles. -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
