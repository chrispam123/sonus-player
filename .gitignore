# ============================================================
# TERRAFORM — Archivos generados y secretos
# ============================================================
# .terraform/         → Providers descargados (se regeneran con terraform init)
# *.tfstate           → Estado local (el real vive en S3)
# *.tfvars.local      → Variables locales con secrets
# secrets.tfvars      → API keys de Terraform (nunca commitear)
# crash.log           → Logs de crash de Terraform
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.backup
secrets.tfvars
*.tfvars.local
infra/crash.log

# ============================================================
# BACKEND — JARs compilados de Kotlin Lambdas
# ============================================================
# Los JARs se generan en CI/CD, no se guardan en el repo
backend/**/build/
backend/**/*.jar
